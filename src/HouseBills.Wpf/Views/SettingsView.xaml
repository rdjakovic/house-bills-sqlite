<UserControl x:Class="HouseBills.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:HouseBills.Wpf.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HouseBills.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="700">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <StackPanel Width="440" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Tr Settings_Language}" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      DisplayMemberPath="DisplayName"
                      HorizontalAlignment="Stretch" />
            <TextBlock Text="{loc:Tr Settings_LanguageNote}" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />

            <TextBlock Text="{loc:Tr Settings_Theme}" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,0" />
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      AutomationProperties.Name="{loc:Tr Settings_Theme}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <!-- The second binding only re-runs the converter when the language changes. -->
                                <MultiBinding Converter="{StaticResource EnumText}">
                                    <Binding />
                                    <Binding Source="{x:Static loc:LocalizedStrings.Instance}" Path="[Settings_Theme]" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <ComboBox.ItemContainerStyle>
                    <!-- Screen readers would otherwise announce the enum name in English. -->
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="AutomationProperties.Name">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource EnumText}">
                                    <Binding />
                                    <Binding Source="{x:Static loc:LocalizedStrings.Instance}" Path="[Settings_Theme]" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <TextBlock Text="{loc:Tr Settings_Reminders}" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,4" />
            <CheckBox Content="{loc:Tr Settings_RemindAtSignIn}" IsChecked="{Binding RemindAtSignIn}" />
            <TextBlock Text="{Binding RemindInfo}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="{loc:Tr Settings_Backup}" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,4" />
            <TextBlock Text="{Binding BackupInfo}" TextWrapping="Wrap" />
            <TextBox Text="{Binding BackupFolder, Mode=OneWay}" IsReadOnly="True" Margin="0,6,0,0"
                     AutomationProperties.Name="{loc:Tr Settings_Backup}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{loc:Tr Settings_BackupNow}" Command="{Binding BackUpNowCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="{loc:Tr Settings_Restore}" Command="{Binding RestoreCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
