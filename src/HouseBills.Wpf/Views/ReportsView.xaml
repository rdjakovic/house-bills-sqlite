<UserControl x:Class="HouseBills.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:HouseBills.Wpf.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:HouseBills.Wpf.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReportsViewModel}"
             d:DesignWidth="1000"
             d:DesignHeight="700">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{loc:Tr Reports_Year}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" MinWidth="100" Margin="0,0,8,0" />
            <TextBlock Text="{loc:Tr Reports_RecurringBill}" VerticalAlignment="Center" Margin="8,0,8,0" />
            <ComboBox ItemsSource="{Binding RecurringBillOptions}" SelectedItem="{Binding SelectedRecurringBill}" DisplayMemberPath="Name" MinWidth="200" Margin="0,0,8,0" />
            <Button Content="{loc:Tr Common_Show}" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="{loc:Tr Common_Export}" Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButtonStyle}" />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Margin="0,0,32,0">
                <TextBlock Text="{loc:Tr Reports_TotalDue}" Opacity="0.8" />
                <TextBlock Text="{Binding YearTotal, Converter={StaticResource Money}}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
                <TextBlock Text="{loc:Tr Reports_Paid}" Opacity="0.8" />
                <TextBlock Text="{Binding YearPaid, Converter={StaticResource Money}}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource StatusPaidBrush}" />
            </StackPanel>
            <StackPanel Margin="0,0,32,0">
                <TextBlock Text="{loc:Tr Reports_Outstanding}" Opacity="0.8" />
                <TextBlock Text="{Binding YearOutstanding, Converter={StaticResource Money}}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource StatusOverdueBrush}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Tr Reports_PreviousYear}" Opacity="0.8" />
                <TextBlock Text="{Binding PreviousYearTotal, Converter={StaticResource Money}}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="260" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Reports_ByMonth}" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Tr Reports_ByCategory}" Style="{StaticResource SectionTitleStyle}" />

            <!-- Charts are pictures of the tables below, which stay the accessible, exact view of the numbers. -->
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,16,12">
                <lvc:CartesianChart Series="{Binding MonthSeries}"
                                    XAxes="{Binding MonthXAxes}"
                                    YAxes="{Binding MonthYAxes}"
                                    LegendPosition="Top"
                                    LegendTextPaint="{Binding ChartTextPaint}"
                                    TooltipTextPaint="{Binding ChartTextPaint}"
                                    TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                                    ZoomMode="None"
                                    Background="Transparent"
                                    Visibility="{Binding HasChartData, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{loc:Tr Reports_NoChartData}" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChartData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                <lvc:PieChart Series="{Binding CategorySeries}"
                              LegendPosition="Right"
                              Background="Transparent"
                              LegendTextPaint="{Binding ChartTextPaint}"
                              TooltipTextPaint="{Binding ChartTextPaint}"
                              TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                              Visibility="{Binding HasCategoryData, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{loc:Tr Reports_NoCategoryData}" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCategoryData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
                <DataGrid ItemsSource="{Binding Months}" Style="{StaticResource ListGridStyle}" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Tr Column_Month}" Binding="{Binding MonthName}" />
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Height="8" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Tr Column_BillCount}" Binding="{Binding Row.BillCount}" />
                        <DataGridTextColumn Header="{loc:Tr Column_Total}" Binding="{Binding Row.TotalAmount, Converter={StaticResource Money}}" ElementStyle="{StaticResource MoneyCellStyle}" HeaderStyle="{StaticResource MoneyHeaderStyle}" />
                        <DataGridTextColumn Header="{loc:Tr Column_Paid}" Binding="{Binding Row.PaidAmount, Converter={StaticResource Money}}" ElementStyle="{StaticResource MoneyCellStyle}" HeaderStyle="{StaticResource MoneyHeaderStyle}" />
                        <DataGridTextColumn Header="{loc:Tr Column_Outstanding}" Binding="{Binding Row.OutstandingAmount, Converter={StaticResource Money}}" ElementStyle="{StaticResource MoneyCellStyle}" HeaderStyle="{StaticResource MoneyHeaderStyle}" />
                        <DataGridTextColumn Header="{loc:Tr Column_PreviousYear}" Binding="{Binding Row.PreviousYearTotalAmount, Converter={StaticResource Money}}" ElementStyle="{StaticResource MoneyCellStyle}" HeaderStyle="{StaticResource MoneyHeaderStyle}" />
                        <DataGridTextColumn Header="{loc:Tr Column_Change}" Binding="{Binding ChangeFromPreviousYear, Converter={StaticResource Money}}" ElementStyle="{StaticResource MoneyCellStyle}" HeaderStyle="{StaticResource MoneyHeaderStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="2" Grid.Column="1">
                <DataGrid ItemsSource="{Binding CategoryTotals}" Style="{StaticResource ListGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Tr Field_Category}" Binding="{Binding CategoryName}" Width="*" />
                        <DataGridTextColumn Header="{loc:Tr Column_BillCount}" Binding="{Binding BillCount}" />
                        <DataGridTextColumn Header="{loc:Tr Column_Total}" Binding="{Binding TotalAmount, Converter={StaticResource Money}}" SortMemberPath="TotalAmount" ElementStyle="{StaticResource MoneyCellStyle}" HeaderStyle="{StaticResource MoneyHeaderStyle}" />
                        <DataGridTextColumn Header="{loc:Tr Column_Paid}" Binding="{Binding PaidAmount, Converter={StaticResource Money}}" SortMemberPath="PaidAmount" ElementStyle="{StaticResource MoneyCellStyle}" HeaderStyle="{StaticResource MoneyHeaderStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
