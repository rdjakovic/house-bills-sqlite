<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target for the Windows notification API (bill reminders); still runs on Windows 10 1809+. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Regenerate with tools\generate-icon.ps1. -->
    <ApplicationIcon>Assets\HouseBills.ico</ApplicationIcon>
    <!-- LiveCharts2's WPF host depends on SkiaSharp.Views.WPF 3.119, OpenTK 3.3.1 and OpenTK.GLWpfControl 3.3.0, which
         only ship .NET Framework builds; they run on .NET through the compatibility shim (NU1701). That is how LiveCharts2
         is used on modern .NET (the charts render with SkiaSharp's CPU renderer). Suppressed in this project only. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\HouseBills.ico" />
    <!-- Also as a file next to the exe: the icon of reminder notifications. -->
    <None Include="Assets\HouseBills.ico" Link="HouseBills.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HouseBills.Application\HouseBills.Application.csproj" />
    <!-- Referenced only by the composition root (Hosting/HostBuilderExtensions.cs). -->
    <ProjectReference Include="..\HouseBills.Infrastructure\HouseBills.Infrastructure.csproj" />
    <ProjectReference Include="..\HouseBills.Presentation.Resources\HouseBills.Presentation.Resources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Charts on the Reports page. See NU1701 above. -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Daily rolling log files (added alongside the default logging providers). -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Needed so `dotnet ef ... -s src/HouseBills.Wpf` works; not shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HouseBills.Wpf.Tests" />
  </ItemGroup>

</Project>
