<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:HouseBills.Wpf.ViewModels"
                    xmlns:views="clr-namespace:HouseBills.Wpf.Views">

    <!-- Maps page view models to their views for the main window's ContentControl. -->
    <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
        <views:OverviewView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BillsViewModel}">
        <views:BillsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecurringBillsViewModel}">
        <views:RecurringBillsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PayeesViewModel}">
        <views:PayeesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
        <views:CategoriesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <views:ReportsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
</ResourceDictionary>
